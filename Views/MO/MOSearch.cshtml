        </div><br />
        <div class="form-row">
            <div class="col-1">
                <input type="checkbox" id="chkIsDateRange" class="form-control" />
            </div>
            <div class="col-2">
                <input type="date" id="dtStart" class="form-control" />
            </div>
            <div class="col-2">
                <input type="date" id="dtEnd" class="form-control" />
            </div>
            <div class="col-2">
                <input type="button" value="Search" onclick="FillMO();" class="btn btn-outline-primary" />
            </div>
        </div>
        <div id="tblMO" class="table-responsive" style="max-height:90%;max-width:100%; text-align:center;scroll-behavior:auto;height:auto;">
        </div>
    </div>
</div>